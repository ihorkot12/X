{
  "name": "black-bear-performance-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "preview": "vite preview --host=0.0.0.0 --port=4173",
    "preview:test": "vite preview --host=127.0.0.1 --port=4173",
    "serve": "node -e \"process.env.NODE_ENV='production'; import('./server.mjs')\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"api/**/*.js\" \"tests/**/*.ts\" \"*.config.{js,ts}\" \"vite.config.ts\" --max-warnings=0",
    "test": "vitest run --config vitest.config.ts",
    "test:contracts": "vitest run --config vitest.config.ts src/lib/methodology.contract.test.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "cross-env VITE_BBP_REMOTE_SYNC=false vite build && playwright test"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "postcss": "8.5.23",
    "protobufjs": "7.6.5"
  }
}
