# Copy this file to .env.local for local development.
# Never commit .env.local or real secrets.

# Required for /api/gemini. Keep server-side only.
GEMINI_API_KEY=""

# Optional. Defaults to gemini-2.5-flash in api/gemini.js.
GEMINI_MODEL="gemini-2.5-flash"

# Enables the existing local account flow for AI requests without a database session.
# Keep false in production unless this is an intentionally isolated demo deployment.
DEMO_MODE="false"

# Optional public app URL for deployment notes/callbacks.
APP_URL=""

# VITE_BBP_REMOTE_SYNC: Set to "true" on Vercel when /api/sync and Neon are configured.
# Leave empty or "false" for local-only browser storage.
VITE_BBP_REMOTE_SYNC="false"

# DATABASE_URL: Neon Postgres connection string for /api/sync.
# Add this in Vercel project environment variables, not in public client code.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Optional comma-separated account promotion allowlists. Public registration can
# request only athlete or coach; these server-side lists assign elevated roles.
ADMIN_EMAILS=""
METHODOLOGY_EDITOR_EMAILS=""
